{
  "profile": "pe",
  "school": "NJFU",
  "term": {
    "xnm": "2026",
    "xqm": "3"
  },
  "auth": {
    "entry": "ehall",
    "username": "${NJFU_USER}",
    "password": "${NJFU_PASS}",
    "mode": "autofill",
    "pauseOnCaptcha": true,
    "sessionFile": "state/session.json"
  },
  "targets": [
    {
      "id": "P0",
      "alias": [
        "ymq"
      ],
      "courseName": {
        "include": [
          "羽毛球"
        ]
      },
      "priority": 0
    },
    {
      "id": "P1",
      "courseName": {
        "include": [
          "乒乓球"
        ]
      },
      "teacher": {
        "include": [
          "李"
        ]
      },
      "priority": 1
    },
    {
      "id": "P2",
      "courseCode": {
        "exact": [
          "1234567"
        ]
      },
      "priority": 2
    }
  ],
  "strategy": {
    "stopAfterSuccess": true,
    "maxAttemptsPerTarget": 0,
    "fullFallbackAfterSec": 0,
    "_fullFallbackAfterSec_note": "某个目标命中但持续满员超过这么多秒，就把它降级为备选、先去抢下一个目标（单向，不回头）。0 = 关闭，死等最高优先级。"
  },
  "schedule": {
    "startAt": null,
    "prewarmSec": 120,
    "highFreqBeforeSec": 30,
    "highFreqIntervalMs": 400,
    "intervalMs": 2500,
    "maxRunMinutes": 120
  },
  "net": {
    "proxy": null,
    "concurrency": 1,
    "connectTimeoutMs": 15000,
    "readTimeoutMs": 20000,
    "maxRetries": 8,
    "maxRedirects": 20,
    "backoff": {
      "baseMs": 400,
      "factor": 1.2,
      "maxMs": 2000,
      "jitter": 0.35
    },
    "ipv4First": true,
    "rejectUnauthorized": false,
    "_rejectUnauthorized_note": "2026-11-03 实测：*.njfu.edu.cn 证书已于 2025-03-04 过期，严格校验下所有请求都是 CERT_HAS_EXPIRED。这个开关必须保持 false，否则登录都进不去。代价是理论上存在中间人风险，别在公共网络下用。"
  },
  "safety": {
    "dryRun": true,
    "maxSubmitsPerMinute": 6
  },
  "notify": {},
  "_notImplemented": "以下配置项曾经出现在模板里但从未实现，已移除，别再加回来：strategy.nameMatchMode / strategy.requireAllDimensions / schedule.clockSyncSec / net.degradeToDom / net.webvpn / safety.autoDropConflicting / safety.neverDropTypes / notify.webhook / notify.beep / notify.logDir。`node src/cli.js doctor` 会对这类键报警。"
}
