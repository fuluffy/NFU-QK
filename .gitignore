# ── 凭证与运行时产物：绝不可提交 ────────────────────────────────
# state/session.json 等同于登录凭证（含 bzb_njw / SERVERID / CASTGC），
# 拿到它就等于拿到你的账号登录态。
state/
config.json

# ── 取证与侦察产物：含页面快照与会话，且是本机调试资料 ──────────
.recon/
recon/
.state/
*.log

# ── 依赖与工具产物 ────────────────────────────────────────────
node_modules/
.npm/
*.tsbuildinfo

# ── 编辑器 / 系统 ─────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
Desktop.ini
